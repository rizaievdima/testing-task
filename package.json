{
  "name": "testingsolution",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --collect-coverage"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/react-native/extend-expect"
    ],
    "collectCoverageFrom": [
      "App.js",
      "components/**/*.js",
      "services/**/*.js"
    ],
    "coverageThreshold": {
      "global": { "statements": 90, "branches": 90, "functions": 90, "lines": 90 },
      "./App.js": { "statements": 90, "branches": 90, "functions": 90, "lines": 90 },
      "./components/MealDisplay.js": { "statements": 90, "branches": 90, "functions": 90, "lines": 90 },
      "./services/mealService.js": { "statements": 90, "branches": 90, "functions": 90, "lines": 90 }
    }
  },
  "dependencies": {
    "axios": "^1.6.7",
    "expo": "~50.0.5",
    "expo-status-bar": "~1.11.1",
    "react": "18.2.0",
    "react-native": "0.73.2",
    "react-native-safe-area-context": "^4.8.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^12.9.0",
    "jest": "^29.7.0",
    "jest-expo": "~50.0.4",
    "react-test-renderer": "18.2.0"
  },
  "private": true
}
